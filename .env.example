# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=evaluacion_demo

# --- Entrada ---
INPUT_DIR=scripts/fixture
OUTPUT_DIR=output/confidencial

# --- Clasificación de hojas: ai | rules ---
CLASSIFIER=ai

# --- Microsoft Foundry ---
FOUNDRY_RESOURCE=mi-recurso-foundry
FOUNDRY_API_KEY=
MODEL_CLASSIFY=claude-sonnet-5-5
EFFORT_CLASSIFY=low
MAX_TOKENS=4096

# --- Mapa de celdas ---
MODEL_MAP=claude-sonnet-5-5
EFFORT_MAP=medium
MAX_TOKENS_MAP=32000
PROMPT_MAP_VERSION=map-v2

# --- Reglas ---
CONFIDENCE_AUTO=0.85
PROMPT_VERSION=classify-v5

# --- Validaciones económicas ---
TOL_FINDING=0.01
TOL_INTEGRITY_ABS=1
TOL_INTEGRITY_REL=0.0001
